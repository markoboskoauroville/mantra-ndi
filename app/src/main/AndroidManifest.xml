<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase zero has no camera code. The permission is declared because
         phase 1 is the camera and the declaration is not what opens it; the
         app asks nothing of the person on this build, and the trace says so.
         Nothing else is declared. A permission that no code uses is a claim
         the app cannot back, and the last build carried several. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!-- Only needed below Android 10. From Q a crash report reaches Downloads
         through MediaStore instead, which is the route that actually works
         and the reason the old reporter never wrote a file. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".MantraApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_camera"
        android:label="Mantra NDI"
        android:theme="@style/Theme.MantraNdi"
        android:supportsRtl="true">

        <!-- The activity handles a turn of the phone itself rather than being
             recreated, and writes down what the phone reported when it did.
             Phase 1 hangs the preview's orientation off that; the automatic
             answer was wrong six times in the last build, so the numbers are
             recorded before anything depends on them. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
