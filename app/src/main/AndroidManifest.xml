<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The take has sound, and the meter runs whether or not a take does: a
         microphone found dead after the shoot is a shoot that happens again. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!-- NDI: the source is advertised and the frames go out over the local
         network. INTERNET covers the sockets; the multicast permissions are
         what let a receiver on the same Wi-Fi discover the phone at all. A
         phone that streams perfectly and appears in nobody's source list is
         the failure these two prevent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Only needed below Android 10. From Q a DNG and a trace reach Downloads
         through MediaStore instead, which is the route that actually works and
         the reason the old reporter never wrote a file. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".MantraApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_camera"
        android:label="Mantra NDI"
        android:theme="@style/Theme.MantraNdi"
        android:supportsRtl="true">

        <!-- Landscape, and only landscape.

             The camera shoots 16:9 and the phone's screen is 20:9, so held
             across there is height for the whole picture and black at both
             ends for the keys. Held upright there is neither, and following
             the phone between the two was six versions of argument about which
             way the picture should be turned for a case that no longer exists.
             sensorLandscape rather than landscape, so the phone can be held
             either way round and the picture follows.

             The turn is still handled here rather than by being recreated:
             recreating would tear down the capture session and the NDI source,
             which on a live stream is a dropped input at the far end. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:screenOrientation="sensorLandscape" />
    </application>
</manifest>
