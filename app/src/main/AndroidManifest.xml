<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The take has sound, and the meter runs whether or not a take does: a
         microphone found dead after the shoot is a shoot that happens again. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!-- NDI: the source is advertised and the frames go out over the local
         network. INTERNET covers the sockets; the multicast permissions are
         what let a receiver on the same Wi-Fi discover the phone at all. A
         phone that streams perfectly and appears in nobody's source list is
         the failure these two prevent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Only needed below Android 10. From Q a DNG and a trace reach Downloads
         through MediaStore instead, which is the route that actually works and
         the reason the old reporter never wrote a file. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".MantraApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_camera"
        android:label="Mantra Manual Camera"
        android:theme="@style/Theme.MantraNdi"
        android:supportsRtl="true">

        <!-- Both ways up, like any app on a phone.

             This was locked to landscape for two versions, to get the rotation
             argument down to one case while it was being solved. It is solved
             — the camera's own quarter turn is read off the producer's texture
             matrix and taken off the angle — so the lock has done its job.

             The turn is handled here rather than by being recreated:
             recreating would tear down the capture session and the NDI source,
             which on a live stream is a dropped input at the far end. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:screenOrientation="fullUser" />
    </application>
</manifest>
