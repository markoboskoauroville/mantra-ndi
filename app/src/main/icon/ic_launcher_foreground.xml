<?xml version="1.0" encoding="utf-8"?>
<!--
     Mantra Manual Camera, the icon. THIS IS A TEMPLATE: app/build.gradle.kts writes
     the real icon into build/generated/versionIcon with the version number drawn
     under the camera (his rule, 27.9.2026: "in the icon I can already see what my
     version is").

     v95, his instruction: "literally vectorize this image". The camera below is
     traced from his launcher's picture (the old system camera: a flash tab, an
     off-centre hump, a thick lens ring), measured against the 72-unit circle:
     the same shape and the same grey (#A8ADAF). Then only what he asked: a thin
     orange outline (#FF9800) around the body, and the ring between the lens glass
     and the body filled orange. Lifted 4 units so the version fits under it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group android:translateY="-4">
        <!-- The flash tab, top left. -->
        <path android:fillColor="#A8ADAF"
            android:pathData="M38,40.5 L43.2,40.5 L38,42.9 Z" />
        <!-- The body: a chamfered top-left corner, the hump. -->
        <path android:fillColor="#A8ADAF"
            android:pathData="M45.67,42.5 L48.83,42.5 L48.83,39.83 L59.62,39.83 L59.62,42.5 L71.78,42.5 L71.78,66.83 L36.67,66.83 L36.67,45.23 Z" />
        <!-- The ring between the lens glass and the body: orange. -->
        <path android:fillColor="#FF9800"
            android:pathData="M54.23,55.12m-9.57,0a9.57,9.57 0,1 0,19.14 0a9.57,9.57 0,1 0,-19.14 0" />
        <!-- The glass, the body's grey. -->
        <path android:fillColor="#A8ADAF"
            android:pathData="M54.23,55.12m-6.71,0a6.71,6.71 0,1 0,13.42 0a6.71,6.71 0,1 0,-13.42 0" />
        <!-- A thin orange outline, 1 unit, just inside the body's edge. -->
        <path android:strokeColor="#FF9800" android:strokeWidth="1" android:strokeLineJoin="miter"
            android:pathData="M45.8,43 L49.33,43 L49.33,40.33 L59.12,40.33 L59.12,43 L71.28,43 L71.28,66.33 L37.17,66.33 L37.17,45.6 Z" />
    </group>
    <!--VERSION-->
</vector>
