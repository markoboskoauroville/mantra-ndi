    <path android:fillColor="#FFFFFF"
        android:pathData="M45,38h14l3,5h9a4,4 0,0 1,4,4v19a4,4 0,0 1,-4,4h-34a4,4 0,0 1,-4,-4v-19a4,4 0,0 1,4,-4h5z" />
