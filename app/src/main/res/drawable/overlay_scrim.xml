<?xml version="1.0" encoding="utf-8"?>
<!-- Barely-there wash so fader text stays legible over a bright image without
     hiding the frame. Darkest in the middle where the faders sit. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#59000000"
        android:centerColor="#A604060A"
        android:endColor="#59000000"
        android:type="linear" />
</shape>
