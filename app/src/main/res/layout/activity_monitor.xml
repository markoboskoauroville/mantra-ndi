<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/videoSurface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/panel" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="280dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#12171C"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Switch to Camera"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sources on the network"
            android:textColor="#78909C"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/sourceList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:choiceMode="singleChoice" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refreshButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Refresh"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#263238" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remote camera"
            android:textColor="#78909C"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/remoteIsoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ISO"
            android:textColor="#78909C"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/remoteIsoSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false" />

        <TextView
            android:id="@+id/remoteShutterLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shutter"
            android:textColor="#78909C"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/remoteShutterSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false" />

        <CheckBox
            android:id="@+id/remoteAutoExposure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Auto exposure"
            android:textColor="#CFD8DC" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recordButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Record on camera"
            android:enabled="false" />

        <TextView
            android:id="@+id/ndiAttribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autoLink="web"
            android:text="Powered by NDI®  https://ndi.video\nNDI® is a registered trademark of Vizrt NDI AB"
            android:textColor="#546E7A"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Looking for sources"
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Connect" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
