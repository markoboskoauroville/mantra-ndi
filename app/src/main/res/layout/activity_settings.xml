<?xml version="1.0" encoding="utf-8"?>
<!--
     The things decided once, off the camera screen.

     Everything an operator touches during a take is a key on a rail, where it
     can be reached without looking. What is here is what is set up beforehand,
     plus the two things that have to live somewhere and do not belong over the
     picture: the NDI attribution the licence requires, and the route that gets
     the trace off the phone.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!--
             The title, the one key that decides how much this screen says, and
             the version.

             The help text is worth having once and is in the way for ever
             after, so MIN is a mode of the screen rather than a setting. The
             version is here because it is the first thing he checks after an
             install and it used to be at the bottom of a long scroll.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textColor="@color/sand"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08" />

            <!-- v104: the light, the first thing in settings (grey off, green on) -->
            <ImageButton
                android:id="@+id/torch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="light"
                android:src="@drawable/ic_torch" />

            <Button
                android:id="@+id/minimal"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/minimal"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/headerVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textColor="@color/amber" />
        </LinearLayout>

        <!--
             v91, THE SWITCHBOARD. "Four distinct, parallel destinations ...
             independent, collapsible activation switches ... when a switch is
             turned on, its configuration panel expands." A switch only ARMS a
             destination; the record key on the camera starts every armed one
             together, and stops them together.
        -->
        <!--
             v104, THE FIRST THINGS (Marko, 2.10.2026: "the first thing important in the settings are something
             I'm using all the time ... the focus size, then this round exposure window, and then light. After that
             we have 8-bit/10-bit switch, and after that we have a resolution"). The light is the lamp at the top.
        -->
        <TextView style="@style/MantraLabel" android:text="FOCUS SQUARE" />
        <TextView android:id="@+id/squareSizeValue" style="@style/MantraValue" />
        <SeekBar android:id="@+id/squareSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
        <TextView style="@style/MantraLabel" android:text="EXPOSURE CIRCLE" />
        <TextView android:id="@+id/circleSizeValue" style="@style/MantraValue" />
        <SeekBar android:id="@+id/circleSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
        <TextView style="@style/MantraLabel" android:text="WHITE BALANCE TRIANGLE" />
        <TextView android:id="@+id/triangleSizeValue" style="@style/MantraValue" />
        <SeekBar android:id="@+id/triangleSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingTop="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:orientation="vertical">
                <TextView style="@style/MantraLabel"
                    android:paddingTop="0dp"
                    android:text="@string/depth" />
                <RadioGroup
                    android:id="@+id/depth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:orientation="vertical">
                <TextView style="@style/MantraLabel"
                    android:paddingTop="0dp"
                    android:text="@string/resolution" />
                <RadioGroup
                    android:id="@+id/resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:tag="hint" style="@style/MantraHint"
            android:text="@string/depth_hint" />

        <TextView style="@style/MantraLabel" android:text="@string/outputs" />
        <!-- v106: "give me toggle in the settings to hide the streaming status display" -->
        <Switch
            android:id="@+id/showOutputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/sand"
            android:text="SHOW ON THE CAMERA" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/outputs_hint" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/sand"
                android:text="FILE" />
            <Switch
                android:id="@+id/armFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/panelFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:visibility="gone">
            <TextView style="@style/MantraLabel" android:text="@string/record_to" />
            <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/record_to_hint" />
            <TextView android:id="@+id/recordFolder" style="@style/MantraValue" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/chooseFolder"
                    style="@style/MantraKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/choose_folder" />
                <Button
                    android:id="@+id/defaultFolder"
                    style="@style/MantraKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/default_folder" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/sand"
                android:text="USB" />
            <Switch
                android:id="@+id/armUsb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/panelUsb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:visibility="gone">
            <TextView style="@style/MantraHint" android:text="@string/usb_obs_soon" />
            <!-- The cable -->
            <TextView style="@style/MantraLabel" android:text="@string/usb" />
            <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/usb_hint" />
            <TextView
                android:id="@+id/usbState"
                style="@style/MantraValue"
                android:lineSpacingMultiplier="1.35"
                android:paddingBottom="8dp" />
            <Button
                android:id="@+id/usbSettings"
                style="@style/MantraKey"
                android:layout_width="match_parent"
                android:text="@string/usb_open" />
            <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/usb_webcam" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/sand"
                android:text="NDI" />
            <Switch
                android:id="@+id/armNdi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/panelNdi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:visibility="gone">
            <TextView style="@style/MantraLabel" android:text="@string/ndi_kind" />
            <RadioGroup
                android:id="@+id/ndiKind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
            <!-- The source name -->
            <TextView style="@style/MantraLabel" android:text="@string/source_name" />
            <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/source_name_hint" />
            <EditText
                android:id="@+id/sourceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/sand"
                android:textColorHint="@color/quiet"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:autofillHints="name"
                android:background="@color/surface"
                android:padding="10dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/sand"
                android:text="YOUTUBE" />
            <Switch
                android:id="@+id/armYoutube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/panelYoutube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:visibility="gone">
            <TextView style="@style/MantraHint" android:text="@string/youtube_soon" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/slate" />

        <!-- v85: the LUT library, this lens's turn, zebra -->


        <TextView style="@style/MantraLabel" android:text="@string/luts" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/luts_hint" />
        <LinearLayout
            android:id="@+id/lutList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <Button
            android:id="@+id/addLut"
            style="@style/MantraKey"
            android:layout_width="match_parent"
            android:text="@string/add_lut" />

        <!-- v104: "Turn the preview" is gone; the turn is always 0 (Marko, 2.10.2026) -->

        <TextView style="@style/MantraLabel" android:text="@string/zebra" />
        <TextView android:id="@+id/zebraValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/zebra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50" />

        <!--
             The wire first.

             This is the one he changes on nearly every shoot, and it was four
             blocks down the page under two things that get set once and left.
             What is touched most often goes at the top.
        -->
        <TextView style="@style/MantraLabel" android:text="@string/bitrate" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/bitrate_hint" />
        <TextView
            android:id="@+id/bitRateValue"
            style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/bitRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="98" />

        <!-- v97: the picture path, and the stream's own bit rate on the GPU stage -->
        <TextView style="@style/MantraLabel" android:text="@string/picture_path" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/picture_path_hint" />
        <RadioGroup
            android:id="@+id/picturePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
        <TextView style="@style/MantraLabel" android:text="@string/stream_bitrate" />
        <TextView
            android:id="@+id/streamBitRateValue"
            style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/streamBitRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="48" />

        <!--
             Depth and size on one line.

             Two radio strips side by side rather than two labelled blocks with
             a paragraph each: they are both answers to "what shape is the
             picture", they are both two or three words wide, and stacking them
             cost half a screen for nothing.
        -->


        <!--
             Frames a second: the first thing anybody sets on a camera.

             It was 30, in the code, with nothing on any screen to say so —
             which on a camera is not a default but a missing control. The list
             is what this phone's lenses publish and will hold steady, for the
             same reason the resolutions are: a rate the sensor cannot sustain
             is a session that quietly runs at something else.
        -->
        <TextView style="@style/MantraLabel" android:text="@string/frame_rate" />
        <TextView android:tag="hint" style="@style/MantraHint"
            android:text="@string/frame_rate_hint" />
        <RadioGroup
            android:id="@+id/frameRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />





        <!-- Bitrate -->


        <!-- Focus -->
        <TextView style="@style/MantraLabel" android:text="@string/focus" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/focus_hint" />
        <TextView android:id="@+id/holdValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/hold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />
        <TextView android:id="@+id/rackValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/rack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <!-- v99: tracking focus, every parameter -->
        <TextView style="@style/MantraLabel" android:text="@string/tracking" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/tracking_hint" />
        <TextView android:id="@+id/trackSearchValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/trackSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="25" />
        <TextView android:id="@+id/trackEveryValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/trackEvery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9" />
        <TextView android:id="@+id/trackConfidenceValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/trackConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="75" />
        <TextView android:id="@+id/trackToleranceValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/trackTolerance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="24" />
        <TextView android:id="@+id/trackFollowValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/trackFollow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="90" />

        <!-- Peaking -->
        <TextView style="@style/MantraLabel" android:text="@string/peaking" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/peaking_hint" />
        <TextView android:id="@+id/peakValue" style="@style/MantraValue" />
        <SeekBar
            android:id="@+id/peak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />
        <RadioGroup
            android:id="@+id/peakColour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp" />



        <!-- The trace -->
        <TextView style="@style/MantraLabel" android:text="@string/trace" />
        <TextView android:tag="hint" style="@style/MantraHint" android:text="@string/trace_hint" />
        <Button
            android:id="@+id/exportTrace"
            style="@style/MantraKey"
            android:layout_width="match_parent"
            android:text="@string/export_trace" />

        <!-- What the licence requires, and where it belongs -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="14dp"
            android:background="@color/slate" />

        <TextView
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:lineSpacingMultiplier="1.35"
            android:textColor="@color/quiet"
            android:text="@string/ndi_mark" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp"
            android:textColor="@color/quiet" />
    </LinearLayout>
</ScrollView>
