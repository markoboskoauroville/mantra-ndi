<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0C0F"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="26dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="18dp"
            android:text="Settings"
            android:textColor="#ECEFF1"
            android:textSize="30sp" />

        <!-- The mode decides what everything below it means -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/settings_group">

            <TextView android:id="@+id/modeLocal" style="@style/MantraModeTab"
                android:text="Local" />

            <TextView android:id="@+id/modeRemote" style="@style/MantraModeTab"
                android:text="Remote" />

            <TextView android:id="@+id/modeMonitor" style="@style/MantraModeTab"
                android:text="Monitor" />

            <TextView android:id="@+id/modeSystem" style="@style/MantraModeTab"
                android:text="System" />

        </LinearLayout>

        <TextView
            android:id="@+id/modeDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="14dp"
            android:textColor="#7C8894"
            android:textSize="12sp" />

        <!-- Capture -->
        <LinearLayout android:id="@+id/groupCapture" style="@style/MantraSettingsGroup">

            <LinearLayout android:id="@+id/rowLens" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Lens" />
                <TextView android:id="@+id/valueLens" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowRecording" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Recording" />
                <TextView android:id="@+id/valueRecording" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowProfile" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Capture profile" />
                <TextView android:id="@+id/valueProfile" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowSourceName" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="NDI source name" />
                <TextView android:id="@+id/valueSourceName" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowBitDepth" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Bit depth" />
                <TextView android:id="@+id/valueBitDepth" style="@style/MantraSettingsValue" />
            </LinearLayout>

        </LinearLayout>

        <!-- Colour -->
        <LinearLayout android:id="@+id/groupColour" style="@style/MantraSettingsGroup">

            <LinearLayout android:id="@+id/rowLogCurve" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Log curve" />
                <TextView android:id="@+id/valueLogCurve" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowExportLut" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Export LUT" />
                <TextView android:id="@+id/valueExportLut" style="@style/MantraSettingsValue"
                    android:text="Generated on demand, no files stored" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowLoadLut" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Monitor LUT" />
                <TextView android:id="@+id/valueLoadLut" style="@style/MantraSettingsValue"
                    android:text="None loaded" />
            </LinearLayout>

        </LinearLayout>

        <!-- Display -->
        <LinearLayout android:id="@+id/groupDisplay" style="@style/MantraSettingsGroup">

            <LinearLayout android:id="@+id/rowFocusBox" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Focus box size" />
                <TextView android:id="@+id/valueFocusBox" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowAiFocus" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="AI focus key" />
                <TextView android:id="@+id/valueAiFocus" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowFocusTiming" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Focus hold and rack" />
                <TextView android:id="@+id/valueFocusTiming" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowWaveform" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Waveform" />
                <TextView android:id="@+id/valueWaveform" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowScreen" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Screen and battery" />
                <TextView android:id="@+id/valueScreen" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowTimecode" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Timecode" />
                <TextView android:id="@+id/valueTimecode" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowNetwork" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="NDI network test" />
                <TextView style="@style/MantraSettingsValue"
                    android:text="Why two phones cannot see each other" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowHistogram" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Vectorscope" />
                <TextView android:id="@+id/valueHistogram" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowStabilisation" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Stabilisation" />
                <TextView android:id="@+id/valueStabilisation" style="@style/MantraSettingsValue" />
            </LinearLayout>

        </LinearLayout>

        <!-- This device -->
        <LinearLayout android:id="@+id/groupDevice" style="@style/MantraSettingsGroup">

            <LinearLayout android:id="@+id/rowCamera" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Camera" />
                <TextView android:id="@+id/valueCamera" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowKeys" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Hardware keys" />
                <TextView android:id="@+id/valueKeys" style="@style/MantraSettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowDetect" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="Detect camera features" />
                <TextView style="@style/MantraSettingsValue"
                    android:text="Every camera, what it records, encoders, storage" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowAbout" style="@style/MantraSettingsRow">
                <TextView style="@style/MantraSettingsTitle" android:text="About" />
                <TextView android:id="@+id/valueAbout" style="@style/MantraSettingsValue" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="18dp"
            android:autoLink="web"
            android:text="Powered by NDI®  https://ndi.video\nNDI® is a registered trademark of Vizrt NDI AB"
            android:textColor="#4A555F"
            android:textSize="9sp" />

    </LinearLayout>

</ScrollView>
