<?xml version="1.0" encoding="utf-8"?>
<!--
     Landscape, and only landscape.

     The app used to follow the phone and re-lay itself out both ways up. It is
     locked across now, because that is how this camera is held and because a
     20:9 screen turned sideways is where the room is: the 16:9 picture takes
     the height, and the two rails live in the black at either end of it
     instead of in bands above and below that eat the picture.

     There is no layout-land twin on purpose. Two files is two places for the
     ids to drift apart, and an earlier build lost a day to exactly that.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/railLeft"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="3dp" />

        <com.mantraproductions.ndi.AspectFrame
            android:id="@+id/picture"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center">

            <TextureView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Over the picture, under nothing. Invisible until touched. -->
            <com.mantraproductions.ndi.ControlZones
                android:id="@+id/zones"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.mantraproductions.ndi.FocusSquareView
                android:id="@+id/focusSquare"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!--
                 The audio, down the inside edge of the picture.

                 A hairline, because the picture is what is being looked at and
                 a meter only has to answer two questions: is there sound, and
                 is it clipping. It runs whenever the app does, not only during
                 a take — a dead microphone found after the take is a take that
                 has to happen again.
            -->
            <com.mantraproductions.ndi.VuMeterView
                android:id="@+id/vu"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:layout_marginTop="42dp"
                android:layout_marginBottom="20dp" />

            <!--
                 The status, across the middle.

                 It was at the top left, which is where the four manual values
                 now are, and two lines of monospace in the same corner is one
                 line nobody can read. The middle is the one place on a picture
                 that is never covered by anything else on this screen.
            -->
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="4dp"
                android:fontFamily="monospace"
                android:textSize="9sp"
                android:textColor="#9AA0A6"
                android:shadowColor="#000000"
                android:shadowRadius="3"
                android:text="@string/starting" />

            <!--
                 The geometry, on screen.

                 This app has shipped a stretched or sideways picture six times,
                 and every one of those was diagnosed by holding a phone up to
                 something rectangular and arguing. These are the five numbers
                 that decide it, so a single screenshot settles what used to
                 take days.
            -->
            <TextView
                android:id="@+id/geometry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:padding="4dp"
                android:fontFamily="monospace"
                android:textSize="8sp"
                android:textColor="#8A9299"
                android:shadowColor="#000000"
                android:shadowRadius="3" />
        </com.mantraproductions.ndi.AspectFrame>

        <LinearLayout
            android:id="@+id/railRight"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="3dp" />
    </LinearLayout>
</FrameLayout>
