<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070A">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.mantraproductions.ndi.FocusSquareView
        android:id="@+id/focusSquare"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview" />

    <com.mantraproductions.ndi.TallyBorderView
        android:id="@+id/tallyBorder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Audio as a hairline across the very top. Costs no room, hides nothing,
         and is the tell that the camera is still running. -->
    <com.mantraproductions.ndi.HairlineVuView
        android:id="@+id/vuHairline"
        android:layout_width="0dp"
        android:layout_height="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.14"
        android:text="IDLE"
        android:textAllCaps="true"
        android:textColor="#8C99A6"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/vuHairline"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- Tap the image: every manual control at once, in columns -->
    <LinearLayout
        android:id="@+id/verticalPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:background="#7A05070A"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/vuHairline"
        app:layout_constraintBottom_toTopOf="@id/controlRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/aIso"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="6dp" />

            <com.mantraproductions.ndi.VerticalFaderView
                android:id="@+id/vIso"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/aShutter"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="6dp" />

            <com.mantraproductions.ndi.VerticalFaderView
                android:id="@+id/vShutter"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/aWhiteBalance"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="6dp" />

            <com.mantraproductions.ndi.VerticalFaderView
                android:id="@+id/vWhiteBalance"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/aFocus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="6dp" />

            <com.mantraproductions.ndi.VerticalFaderView
                android:id="@+id/vFocus"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/aZoom"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="6dp" />

            <com.mantraproductions.ndi.VerticalFaderView
                android:id="@+id/vZoom"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

    </LinearLayout>

    <CheckBox
        android:id="@+id/autoModeCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="10dp"
        android:buttonTint="#E7A44C"
        android:text="Auto"
        android:textColor="#B6C0CA"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/vuHairline"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Normal state: two rings and the gear -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/centreGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <com.mantraproductions.ndi.CircleButtonView
            android:id="@+id/recordButton"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/centreGuide" />

        <com.mantraproductions.ndi.CircleButtonView
            android:id="@+id/settingsButton"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginStart="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/centreGuide" />

        <com.mantraproductions.ndi.CircleButtonView
            android:id="@+id/gearButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="18dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Adjusting state: one fader, replacing the rings entirely -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/paramBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.mantraproductions.ndi.CircleButtonView
            android:id="@+id/paramCycleButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.mantraproductions.ndi.FaderView
            android:id="@+id/paramFader"
            android:layout_width="0dp"
            android:layout_height="78dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/paramCycleButton"
            app:layout_constraintEnd_toStartOf="@id/paramCloseButton" />

        <com.mantraproductions.ndi.CircleButtonView
            android:id="@+id/paramCloseButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
