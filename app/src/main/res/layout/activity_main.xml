<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E11">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/panel" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="280dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#12171C"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="#78909C"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/profileSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="NDI source name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/sourceNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mantra NDI"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/manualExposureCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Manual exposure"
            android:textColor="#CFD8DC" />

        <TextView
            android:id="@+id/isoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ISO"
            android:textColor="#78909C"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/isoSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/shutterLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shutter"
            android:textColor="#78909C"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/shutterSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/stabilizationCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stabilization"
            android:textColor="#CFD8DC" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Idle"
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startStopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start streaming" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
