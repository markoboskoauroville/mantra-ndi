<?xml version="1.0" encoding="utf-8"?>
<!--
     One layout for both ways up.

     The stage is a LinearLayout whose orientation the activity sets from the
     phone's rotation: across in landscape, so the rails are the left and right
     margins of the picture; down in portrait, so they are the bands above and
     below it. The keys, their order and their meaning never move, which is the
     point — a hand that has learned this rail keeps it when the phone turns.

     There is no layout-land twin on purpose. Two files is two places for the
     ids to drift apart, and the last build lost a day to exactly that.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/railLeft"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="3dp" />

        <com.mantraproductions.ndi.AspectFrame
            android:id="@+id/picture"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center">

            <TextureView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.mantraproductions.ndi.FocusSquareView
                android:id="@+id/focusSquare"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:padding="4dp"
                android:fontFamily="monospace"
                android:textSize="9sp"
                android:textColor="#9AA0A6"
                android:shadowColor="#000000"
                android:shadowRadius="3"
                android:text="@string/starting" />
            <!-- The NDI licence requires this in the interface, not only in
                 the README. Quiet and small, at the foot of the picture where
                 it costs no room a control could have used. -->
            <TextView
                android:id="@+id/ndiMark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:padding="3dp"
                android:fontFamily="monospace"
                android:textSize="7sp"
                android:textColor="#55606A"
                android:text="@string/ndi_mark" />
        </com.mantraproductions.ndi.AspectFrame>

        <LinearLayout
            android:id="@+id/railRight"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="3dp" />
    </LinearLayout>
</FrameLayout>
