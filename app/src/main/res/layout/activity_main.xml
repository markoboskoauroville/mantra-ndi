<?xml version="1.0" encoding="utf-8"?>
<!--
     One layout for both ways up.

     The stage is a LinearLayout whose orientation the activity sets from the
     phone's rotation: across in landscape, so the rails are the left and right
     margins of the picture; down in portrait, so they are the bands above and
     below it. The keys, their order and their meaning never move, which is the
     point — a hand that has learned this rail keeps it when the phone turns.

     It was locked to landscape for two versions, to get the rotation argument
     down to one case while it was being solved. It is solved, so the lock has
     done its job.

     There is no layout-land twin on purpose. Two files is two places for the
     ids to drift apart, and an earlier build lost a day to exactly that.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/railLeft"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="3dp" />

        <com.mantraproductions.ndi.AspectFrame
            android:id="@+id/picture"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center">

            <TextureView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Over the picture, under nothing. Invisible until touched. -->
            <com.mantraproductions.ndi.ControlZones
                android:id="@+id/zones"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.mantraproductions.ndi.FocusSquareView
                android:id="@+id/focusSquare"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!--
                 The audio, down the inside edge of the picture.

                 A hairline, because the picture is what is being looked at and
                 a meter only has to answer two questions: is there sound, and
                 is it clipping. It runs whenever the app does, not only during
                 a take — a dead microphone found after the take is a take that
                 has to happen again.
            -->
            <com.mantraproductions.ndi.VuMeterView
                android:id="@+id/vu"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp" />

            <!--
                 The status, pinned to the top edge.

                 It was put in the middle of the picture for one version, to
                 keep it off the manual values, and the middle of the picture is
                 the one place on a camera that must stay clear — it is where
                 the subject is. The faders start below this line instead.
            -->
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:fontFamily="monospace"
                android:textSize="9sp"
                android:textColor="#9AA0A6"
                android:shadowColor="#000000"
                android:shadowRadius="3"
                android:text="@string/starting" />

            <!--
                 The iris, in the corner with the other facts.

                 It was a fader with no track and the width of one, which is a
                 row of empty space where a control should be. A phone has one
                 aperture — it is a fact about the lens, not something anybody
                 can set — so it reads like the status line rather than
                 pretending to be a slider.
            -->
            <TextView
                android:id="@+id/iris"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:paddingTop="18dp"
                android:paddingEnd="6dp"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#C8CDD2"
                android:shadowColor="#000000"
                android:shadowRadius="3"
                android:visibility="gone" />

            <!--
                 Timecode, record run, HH:MM:SS:FF: grey while standing by, red
                 while a take runs, as on any camera's display.
            -->
            <TextView
                android:id="@+id/timecode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:padding="4dp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#C8DCE0E4"
                android:shadowColor="#000000"
                android:shadowRadius="3"
                android:text="00:00:00:00" />

            <!--
                 The geometry, on screen.

                 This app has shipped a stretched or sideways picture six times,
                 and every one of those was diagnosed by holding a phone up to
                 something rectangular and arguing. These are the five numbers
                 that decide it, so a single screenshot settles what used to
                 take days.
            -->
            <TextView
                android:id="@+id/geometry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:padding="4dp"
                android:fontFamily="monospace"
                android:textSize="8sp"
                android:textColor="#8A9299"
                android:shadowColor="#000000"
                android:shadowRadius="3" />
        </com.mantraproductions.ndi.AspectFrame>

        <LinearLayout
            android:id="@+id/railRight"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="3dp" />
    </LinearLayout>

    <!--
         The clean feed's only control, and it is invisible.

         In full screen there is nothing on the glass but the picture — no
         rails, no status, no meter, no geometry — because the phone's screen
         is the broadcast. Something still has to be able to bring the camera
         back, and it cannot be a key, because a key is a thing on the screen.
         So the whole picture takes a double tap, and this view sits over
         everything to catch it: over the rails, which are gone, and over the
         focus box, which is also gone, so a single accidental touch during a
         take cannot rack the lens or move an exposure.
    -->
    <View
        android:id="@+id/fullScreenCatcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
