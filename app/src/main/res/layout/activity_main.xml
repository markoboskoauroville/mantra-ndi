<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- The image, letterboxed to its own shape. Everything else is anchored
         to this view rather than to the window, so nothing lands on a black
         bar beside the picture. -->
    <!-- A TextureView rather than a SurfaceView: its contents can be read
         back, which is what lets the scope work on every pipeline instead of
         only the one that can carry an analysis stream. -->
    <TextureView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.mantraproductions.ndi.TallyBorderView
        android:id="@+id/tallyBorder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview" />

    <com.mantraproductions.ndi.FocusSquareView
        android:id="@+id/focusSquare"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview" />

    <!-- Remote frame. Constrained to start BELOW the meter, so no drawing
         order, animation or later edit can put it over the audio. -->
    <com.mantraproductions.ndi.RemoteBorderView
        android:id="@+id/remoteBorder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/vuHairline"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview" />

    <!-- Column for column with the image, so a part of the frame and its
         trace are at the same horizontal position. -->
    <com.mantraproductions.ndi.WaveformView
        android:id="@+id/waveform"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.55"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview" />

    <com.mantraproductions.ndi.HairlineVuView
        android:id="@+id/vuHairline"
        android:layout_width="0dp"
        android:layout_height="2dp"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview" />

    <!-- Big enough to read at arm's length, which is where a phone on a rig
         is. Amber while free running, green once a generator is heard. -->
    <TextView
        android:id="@+id/timecodeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.06"
        android:textColor="#12C46A"
        android:textSize="17sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/vuHairline"
        app:layout_constraintEnd_toStartOf="@id/controlRow" />

    <!-- Read constantly during a take, so it sits where the eye already goes
         and is monospaced, because digits that shift width are unreadable at
         a glance. -->
    <TextView
        android:id="@+id/timecodeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:fontFamily="monospace"
        android:textColor="#E7A44C"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/vuHairline"
        app:layout_constraintEnd_toStartOf="@id/controlRow" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:letterSpacing="0.12"
        android:text="IDLE"
        android:textAllCaps="true"
        android:textColor="#8C99A6"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/vuHairline"
        app:layout_constraintStart_toStartOf="@id/preview" />

    <!-- Right edge: record on top, menu, gear at the bottom. The hand reaches
         one column and never crosses the frame. -->
    <LinearLayout
        android:id="@+id/controlRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="8dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Focus first, at the top, clear of the system gesture area at the
             bottom of the screen. M or A, and nothing else. -->
        <com.mantraproductions.ndi.CircleButtonView
            android:id="@+id/focusModeButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginBottom="14dp" />

        <com.mantraproductions.ndi.CircleButtonView
            android:id="@+id/recordButton"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginBottom="14dp" />

        <!-- Going live had been a long press on the record ring, which is
             discoverable only to whoever wrote it. It is a button now. -->
        <com.mantraproductions.ndi.CircleButtonView
            android:id="@+id/streamButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginBottom="14dp" />

        <com.mantraproductions.ndi.CircleButtonView
            android:id="@+id/settingsButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp" />

        <!-- Which source is being watched. Only in the modes where the
             picture comes from somewhere else. -->
        <com.mantraproductions.ndi.CircleButtonView
            android:id="@+id/sourceButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone" />

        <com.mantraproductions.ndi.CircleButtonView
            android:id="@+id/gearButton"
            android:layout_width="44dp"
            android:layout_height="44dp" />

    </LinearLayout>

    <!-- The control columns, ending where the action column begins so the two
         never share a pixel. -->
    <LinearLayout
        android:id="@+id/verticalPanel"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="34dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintEnd_toStartOf="@id/controlRow">

        <LinearLayout style="@style/MantraColumn">
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/rIso" style="@style/MantraAuto" />
            <com.mantraproductions.ndi.VerticalFaderView
                android:id="@+id/vIso" style="@style/MantraFader" />
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/plusIso" style="@style/MantraStep" />
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/minusIso" style="@style/MantraStep" />
        </LinearLayout>

        <LinearLayout style="@style/MantraColumn">
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/rShutter" style="@style/MantraAuto" />
            <com.mantraproductions.ndi.VerticalFaderView
                android:id="@+id/vShutter" style="@style/MantraFader" />
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/plusShutter" style="@style/MantraStep" />
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/minusShutter" style="@style/MantraStep" />
        </LinearLayout>

        <LinearLayout style="@style/MantraColumn">
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/rWhiteBalance" style="@style/MantraAuto" />
            <com.mantraproductions.ndi.VerticalFaderView
                android:id="@+id/vWhiteBalance" style="@style/MantraFader" />
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/plusWhiteBalance" style="@style/MantraStep" />
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/minusWhiteBalance" style="@style/MantraStep" />
        </LinearLayout>

        <LinearLayout style="@style/MantraColumn">
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/rFocus" style="@style/MantraAuto" />
            <com.mantraproductions.ndi.VerticalFaderView
                android:id="@+id/vFocus" style="@style/MantraFader" />
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/plusFocus" style="@style/MantraStep" />
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/minusFocus" style="@style/MantraStep" />
        </LinearLayout>

        <LinearLayout style="@style/MantraColumn">
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/rZoom" style="@style/MantraAuto" />
            <com.mantraproductions.ndi.VerticalFaderView
                android:id="@+id/vZoom" style="@style/MantraFader" />
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/plusZoom" style="@style/MantraStep" />
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/minusZoom" style="@style/MantraStep" />
        </LinearLayout>

        <LinearLayout style="@style/MantraColumn">
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/rGain" style="@style/MantraAuto" />
            <com.mantraproductions.ndi.VerticalFaderView
                android:id="@+id/vGain" style="@style/MantraFader" />
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/plusGain" style="@style/MantraStep" />
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/minusGain" style="@style/MantraStep" />
        </LinearLayout>

        <!-- Video Auto, last in the row so it sits nearest the hand. -->
        <LinearLayout style="@style/MantraColumn">
            <com.mantraproductions.ndi.CircleButtonView
                android:id="@+id/autoAllButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Full screen, and alone. Balancing is a thing you stop to do, and a
         scope competing with six faders for the same glass is a scope nobody
         can read. Long press it to put everything back. -->
    <com.mantraproductions.ndi.VectorscopeView
        android:id="@+id/vectorscope"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC05070A"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview" />

    <!-- Three way grade. Lift, gamma, gain, each with its own master. -->
    <LinearLayout
        android:id="@+id/gradePanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC05070A"
        android:padding="10dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toStartOf="@id/controlRow">

        <com.mantraproductions.ndi.ColourWheelView
            android:id="@+id/wheelLift"
            android:layout_width="0dp"
            android:layout_height="168dp"
            android:layout_weight="1" />

        <com.mantraproductions.ndi.ColourWheelView
            android:id="@+id/wheelGamma"
            android:layout_width="0dp"
            android:layout_height="168dp"
            android:layout_weight="1" />

        <com.mantraproductions.ndi.ColourWheelView
            android:id="@+id/wheelGain"
            android:layout_width="0dp"
            android:layout_height="168dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- One fader at a time, reached by holding the menu button. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/paramBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="6dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toStartOf="@id/controlRow">

        <com.mantraproductions.ndi.CircleButtonView
            android:id="@+id/paramCycleButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.mantraproductions.ndi.FaderView
            android:id="@+id/paramFader"
            android:layout_width="0dp"
            android:layout_height="74dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/paramCycleButton"
            app:layout_constraintEnd_toStartOf="@id/paramCloseButton" />

        <com.mantraproductions.ndi.CircleButtonView
            android:id="@+id/paramCloseButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
