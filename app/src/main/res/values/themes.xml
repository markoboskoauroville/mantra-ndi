<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MantraNdi" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/amber</item>
        <item name="colorAccent">@color/amber</item>
        <item name="android:windowBackground">@color/ink</item>
    </style>

    <!-- A key. Slate ground, amber rule, sand word: the same key in every row,
         so two controls doing the same kind of job look the same. -->
    <style name="MantraKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/key</item>
        <item name="android:textColor">@color/sand</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
